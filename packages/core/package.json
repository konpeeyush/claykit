{
  "name": "@claykit/core",
  "version": "0.0.2",
  "description": "Framework-independent runtime for claykit procedural avatars.",
  "keywords": ["avatar", "svg", "animation", "procedural", "typescript"],
  "license": "MIT",
  "homepage": "https://github.com/konpeeyush/claykit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konpeeyush/claykit.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
